# HyperLogistics-Stream Environment Variables
# Copy to .env and fill in your values

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=flights_stream

# API
API_HOST=0.0.0.0
API_PORT=8000

# Spark (override defaults)
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Paths (relative to project root, can be overridden)
BTS_RAW_DIR=data/raw/bts
NOAA_RAW_DIR=data/raw/noaa
MODELS_DIR=models
